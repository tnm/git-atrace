#!/bin/bash
#/ git-atrace - View and manage AI coding sessions
#/ Version: 0.1.0
#/
#/ Usage: git atrace <command> [args]
#/
#/ Commands:
#/   git atrace                             List recent sessions
#/   git atrace show <file>                 Sessions that changed a file
#/   git atrace view <session_id>           View full conversation
#/   git atrace files <session_id>          List files changed by a session
#/   git atrace share <session_id>          Share session (copy to tracked location)
#/   git atrace delete <session_id>         Delete a session
#/   git atrace link <session_id> [commit]  Link session to a commit (default HEAD)
#/   git atrace log                         Show commits with linked sessions
#/   git atrace blame <file>                Show file with session attribution (like git blame)
#/   git atrace export <session_id>         Export session to Agent Trace spec format
#/   git atrace import <file>               Import an Agent Trace spec file
#/
#/ Session IDs can be abbreviated (first 8 chars).
#/
#/ Options:
#/   --json                        Output as JSON (list, show, log)
#/
#/ Sharing:
#/   Sessions are shared to .agents/sessions/ if .agents/ exists,
#/   or to a custom path via: git config atrace.sharedir <path>

set -e

# Check we're in a git repo
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "Error: not in a git repository" >&2
    exit 1
fi

# Colors
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RESET='\033[0m'

# Parse global flags
JSON_OUTPUT=0
args=()
for arg in "$@"; do
    case "$arg" in
        --json) JSON_OUTPUT=1 ;;
        *) args+=("$arg") ;;
    esac
done
set -- "${args[@]}"

# Substring helpers
short_id() { printf '%.8s' "$1"; }
short_sha() { printf '%.7s' "$1"; }

# Find git root
git_root() {
    # Resolve symlinks for consistent path matching
    cd "$(git rev-parse --show-toplevel 2>/dev/null)" && pwd -P
}

# Sessions directory (local, not tracked)
local_sessions() {
    echo "$(git_root)/.git/trace/sessions"
}

# Shared sessions directory (tracked)
# Returns path if configured, empty string if not
shared_sessions() {
    local root=$(git_root)

    # Explicit config wins
    local configured=$(git config atrace.sharedir 2>/dev/null)
    if [ -n "$configured" ]; then
        # Handle relative paths
        case "$configured" in
            /*) echo "$configured" ;;
            *)  echo "$root/$configured" ;;
        esac
        return
    fi

    # Piggyback on .agents if it exists
    if [ -d "$root/.agents" ]; then
        echo "$root/.agents/sessions"
        return
    fi

    # No share directory configured
    echo ""
}

# Find session by prefix
# Usage: find_session <prefix> <extension>
# Sets: SESSION_FILE, SESSION_ID, SESSION_LOC
# Returns: 0 if found, 1 if not found
find_session() {
    local prefix="$1" ext="$2"
    local local_dir=$(local_sessions)
    local shared_dir=$(shared_sessions)

    SESSION_FILE=""
    SESSION_ID=""
    SESSION_LOC=""

    # Try local first
    for f in "$local_dir"/${prefix}*."$ext"; do
        [ -e "$f" ] || continue
        SESSION_FILE="$f"
        SESSION_ID=$(basename "$f" ".$ext")
        SESSION_LOC="local"
        return 0
    done

    # Try shared (if configured)
    if [ -n "$shared_dir" ]; then
        for f in "$shared_dir"/${prefix}*."$ext"; do
            [ -e "$f" ] || continue
            SESSION_FILE="$f"
            SESSION_ID=$(basename "$f" ".$ext")
            SESSION_LOC="shared"
            return 0
        done
    fi

    return 1
}

# List all sessions
cmd_list() {
    local local_dir=$(local_sessions)
    local shared_dir=$(shared_sessions)
    local found=0

    local json_first=1

    if [ $JSON_OUTPUT -eq 0 ]; then
        echo -e "${BOLD}Sessions${RESET}"
        echo ""
    else
        printf '['
    fi

    # List local sessions
    if [ -d "$local_dir" ]; then
        for ts_file in "$local_dir"/*.timestamp; do
            [ -e "$ts_file" ] || continue
            local session_id=$(basename "$ts_file" .timestamp)
            local timestamp=$(cat "$ts_file")
            local files_file="$local_dir/${session_id}.files"
            local file_count=0
            [ -f "$files_file" ] && file_count=$(wc -l < "$files_file" | tr -d ' ')

            if [ $JSON_OUTPUT -eq 1 ]; then
                [ $json_first -eq 0 ] && printf ','
                printf '{"id":"%s","timestamp":"%s","files":%d,"location":"local"}' \
                    "$session_id" "$timestamp" "$file_count"
                json_first=0
            else
                echo -e "  ${CYAN}$(short_id "$session_id")${RESET}  $timestamp  ${DIM}($file_count files)${RESET}  [local]"
            fi
            found=1
        done
    fi

    # List shared sessions (if configured)
    if [ -n "$shared_dir" ] && [ -d "$shared_dir" ]; then
        for jsonl_file in "$shared_dir"/*.jsonl; do
            [ -e "$jsonl_file" ] || continue
            local session_id=$(basename "$jsonl_file" .jsonl)
            local files_file="$shared_dir/${session_id}.files"
            local file_count=0
            [ -f "$files_file" ] && file_count=$(wc -l < "$files_file" | tr -d ' ')

            if [ $JSON_OUTPUT -eq 1 ]; then
                [ $json_first -eq 0 ] && printf ','
                printf '{"id":"%s","files":%d,"location":"shared"}' \
                    "$session_id" "$file_count"
                json_first=0
            else
                echo -e "  ${GREEN}$(short_id "$session_id")${RESET}  (shared)  ${DIM}($file_count files)${RESET}  [shared]"
            fi
            found=1
        done
    fi

    if [ $JSON_OUTPUT -eq 1 ]; then
        printf ']\n'
    elif [ $found -eq 0 ]; then
        echo "  No sessions found."
        echo ""
        echo "  Sessions are captured automatically via post-tool hooks."
        echo "  See README for setup: Claude Code, OpenCode, or Gemini CLI."
    fi
}

# Show sessions that changed a file
cmd_show() {
    local target_file="$1"
    if [ -z "$target_file" ]; then
        echo "Usage: git atrace show <file>"
        exit 1
    fi

    local root=$(git_root)

    # Compute both absolute and relative forms for matching (resolve symlinks)
    local abs_path=""
    local rel_path=""
    if [ -e "$target_file" ]; then
        abs_path=$(cd "$(dirname "$target_file")" 2>/dev/null && pwd -P)/$(basename "$target_file")
        rel_path="${abs_path#$root/}"
    else
        case "$target_file" in
        /*)
            # Absolute path to non-existent file - resolve directory symlinks if possible
            local dir_path=$(dirname "$target_file")
            if [ -d "$dir_path" ]; then
                abs_path=$(cd "$dir_path" && pwd -P)/$(basename "$target_file")
            else
                abs_path="$target_file"
            fi
            rel_path="${abs_path#$root/}"
            ;;
        *)
            # Relative path to non-existent file
            abs_path="$root/$target_file"
            rel_path="$target_file"
            ;;
        esac
    fi

    local found=0
    local json_first=1

    if [ $JSON_OUTPUT -eq 0 ]; then
        echo -e "${BOLD}Sessions for: ${CYAN}$target_file${RESET}"
        echo ""
    else
        printf '['
    fi

    # Search local sessions (match target, absolute, or relative)
    local local_dir=$(local_sessions)
    if [ -d "$local_dir" ]; then
        for files_file in "$local_dir"/*.files; do
            [ -e "$files_file" ] || continue
            if grep -qxF "$target_file" "$files_file" 2>/dev/null || \
               grep -qxF "$abs_path" "$files_file" 2>/dev/null || \
               grep -qxF "$rel_path" "$files_file" 2>/dev/null; then
                local session_id=$(basename "$files_file" .files)
                local ts_file="$local_dir/${session_id}.timestamp"
                local timestamp=""
                [ -f "$ts_file" ] && timestamp=$(cat "$ts_file")
                if [ $JSON_OUTPUT -eq 1 ]; then
                    [ $json_first -eq 0 ] && printf ','
                    printf '{"id":"%s","timestamp":"%s","location":"local"}' \
                        "$session_id" "$timestamp"
                    json_first=0
                else
                    echo -e "  ${CYAN}$(short_id "$session_id")${RESET}  $timestamp  [local]"
                fi
                found=1
            fi
        done
    fi

    # Search shared sessions (if configured)
    local shared_dir=$(shared_sessions)
    if [ -n "$shared_dir" ] && [ -d "$shared_dir" ]; then
        for files_file in "$shared_dir"/*.files; do
            [ -e "$files_file" ] || continue
            if grep -qxF "$target_file" "$files_file" 2>/dev/null || \
               grep -qxF "$abs_path" "$files_file" 2>/dev/null || \
               grep -qxF "$rel_path" "$files_file" 2>/dev/null; then
                local session_id=$(basename "$files_file" .files)
                if [ $JSON_OUTPUT -eq 1 ]; then
                    [ $json_first -eq 0 ] && printf ','
                    printf '{"id":"%s","location":"shared"}' "$session_id"
                    json_first=0
                else
                    echo -e "  ${GREEN}$(short_id "$session_id")${RESET}  [shared]"
                fi
                found=1
            fi
        done
    fi

    if [ $JSON_OUTPUT -eq 1 ]; then
        printf ']\n'
    elif [ $found -eq 0 ]; then
        echo "  No sessions found for this file."
    fi
}

# View a session's conversation
cmd_view() {
    local session_id="$1"
    if [ -z "$session_id" ]; then
        echo "Usage: git atrace view <session_id>"
        exit 1
    fi

    # Check for jq (required for parsing JSONL)
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq is required for viewing sessions" >&2
        echo "Install with: brew install jq" >&2
        exit 1
    fi

    if ! find_session "$session_id" "jsonl"; then
        echo "Session not found: $session_id"
        exit 1
    fi

    echo -e "${BOLD}Session: ${CYAN}${SESSION_ID}${RESET}"
    echo ""

    # Parse and display conversation
    # Only show user and assistant text messages, skip tool results and thinking
    local output
    output=$(jq -r '
        select(.type == "user" or .type == "assistant") |
        select(.message != null) |
        if .type == "user" then
            if (.message.content | type) == "string" then
                "\u001b[33m> " + .message.content + "\u001b[0m\n"
            elif (.message.content | type) == "array" then
                empty
            elif (.message | type) == "string" then
                "\u001b[33m> " + .message + "\u001b[0m\n"
            else
                empty
            end
        elif .type == "assistant" then
            if (.message.content | type) == "array" then
                .message.content[] |
                if .type == "text" then
                    .text + "\n"
                elif .type == "tool_use" then
                    "\u001b[2m[" + .name + "]\u001b[0m\n"
                else
                    empty
                end
            elif (.message | type) == "string" then
                .message + "\n"
            else
                empty
            end
        else
            empty
        end
    ' "$SESSION_FILE" 2>&1) || {
        echo "Error: failed to parse session file (may be corrupted)" >&2
        exit 1
    }

    if [ -z "$output" ]; then
        echo "  (no conversation content found)"
    else
        local total_lines
        total_lines=$(echo "$output" | wc -l | tr -d ' ')
        echo "$output" | head -200
        echo ""
        if [ "$total_lines" -gt 200 ]; then
            echo -e "${DIM}(showing first 200 of $total_lines lines)${RESET}"
        fi
    fi
}

# Share a session (copy to tracked location)
cmd_share() {
    local session_id="$1"
    if [ -z "$session_id" ]; then
        echo "Usage: git atrace share <session_id>"
        exit 1
    fi

    local shared_dir=$(shared_sessions)

    # Check if sharing is configured
    if [ -z "$shared_dir" ]; then
        echo "No share directory configured."
        echo ""
        echo "Either:"
        echo "  git config atrace.sharedir .trace/sessions"
        echo ""
        echo "Or create a .agents/ directory and sessions will go there."
        exit 1
    fi

    if ! find_session "$session_id" "jsonl"; then
        echo "Session not found: $session_id"
        exit 1
    fi

    if [ "$SESSION_LOC" = "shared" ]; then
        echo "Session already shared: $(short_id "$SESSION_ID")"
        exit 0
    fi

    local local_dir=$(local_sessions)

    # Create shared directory
    mkdir -p "$shared_dir"

    # Copy files
    cp "$SESSION_FILE" "$shared_dir/"
    [ -f "$local_dir/${SESSION_ID}.files" ] && cp "$local_dir/${SESSION_ID}.files" "$shared_dir/"
    [ -f "$local_dir/${SESSION_ID}.timestamp" ] && cp "$local_dir/${SESSION_ID}.timestamp" "$shared_dir/"

    # Add to git
    git add "$shared_dir"

    echo -e "${GREEN}Shared session: $SESSION_ID${RESET}"
    echo "Files copied to $shared_dir and staged for commit."
}

# List files changed by a session
cmd_files() {
    local session_id="$1"
    if [ -z "$session_id" ]; then
        echo "Usage: git atrace files <session_id>"
        exit 1
    fi

    if ! find_session "$session_id" "files"; then
        echo "Session not found: $session_id"
        exit 1
    fi

    echo -e "${BOLD}Files in session: ${CYAN}$(short_id "$SESSION_ID")${RESET} [$SESSION_LOC]"
    echo ""

    while IFS= read -r file; do
        echo "  $file"
    done < "$SESSION_FILE"
}

# Delete a session
cmd_delete() {
    local session_id="$1"
    if [ -z "$session_id" ]; then
        echo "Usage: git atrace delete <session_id>"
        exit 1
    fi

    if ! find_session "$session_id" "jsonl"; then
        echo "Session not found: $session_id"
        exit 1
    fi

    local dir=$(dirname "$SESSION_FILE")
    rm -f "$dir/${SESSION_ID}.jsonl"
    rm -f "$dir/${SESSION_ID}.files"
    rm -f "$dir/${SESSION_ID}.timestamp"

    if [ "$SESSION_LOC" = "shared" ]; then
        git add "$dir" 2>/dev/null || true
        echo -e "Deleted shared session: ${GREEN}$(short_id "$SESSION_ID")${RESET} (staged for commit)"
    else
        echo -e "Deleted local session: ${CYAN}$(short_id "$SESSION_ID")${RESET}"
    fi
}

# Git notes ref for session links
NOTES_REF="refs/notes/atrace"

# Link a session to a commit
cmd_link() {
    local session_id="$1"
    local commit="${2:-HEAD}"

    if [ -z "$session_id" ]; then
        echo "Usage: git atrace link <session_id> [commit]"
        exit 1
    fi

    # Resolve commit to full SHA
    local commit_sha
    commit_sha=$(git rev-parse "$commit" 2>/dev/null) || {
        echo "Invalid commit: $commit"
        exit 1
    }

    if ! find_session "$session_id" "jsonl"; then
        echo "Session not found: $session_id"
        exit 1
    fi

    # Add session ID to the commit's note (append if note exists)
    local existing
    existing=$(git notes --ref="$NOTES_REF" show "$commit_sha" 2>/dev/null) || existing=""

    if echo "$existing" | grep -qF "$SESSION_ID"; then
        echo "Session already linked to this commit"
        exit 0
    fi

    if [ -n "$existing" ]; then
        echo -e "${existing}\n${SESSION_ID}" | git notes --ref="$NOTES_REF" add -f -F - "$commit_sha"
    else
        git notes --ref="$NOTES_REF" add -m "$SESSION_ID" "$commit_sha"
    fi

    echo -e "Linked ${CYAN}$(short_id "$SESSION_ID")${RESET} to commit ${YELLOW}$(short_sha "$commit_sha")${RESET}"
}

# Show commits with linked sessions
cmd_log() {
    local count="${1:-10}"

    local found=0
    local json_first=1

    if [ $JSON_OUTPUT -eq 0 ]; then
        echo -e "${BOLD}Commits with sessions${RESET}"
        echo ""
    else
        printf '['
    fi

    while IFS= read -r line; do
        local commit_sha=$(echo "$line" | cut -d' ' -f1)
        local commit_msg=$(echo "$line" | cut -d' ' -f2-)

        local note
        note=$(git notes --ref="$NOTES_REF" show "$commit_sha" 2>/dev/null) || continue

        found=1

        if [ $JSON_OUTPUT -eq 1 ]; then
            [ $json_first -eq 0 ] && printf ','
            # Collect session IDs into a JSON array
            local sessions_json="["
            local sfirst=1
            while IFS= read -r sid; do
                [ -z "$sid" ] && continue
                [ $sfirst -eq 0 ] && sessions_json+=","
                sessions_json+="\"$sid\""
                sfirst=0
            done <<< "$note"
            sessions_json+="]"
            # Use jq for safe JSON escaping of commit message
            printf '%s' "$commit_msg" | jq -Rs --arg sha "$commit_sha" --argjson sessions "$sessions_json" \
                '{"commit":$sha,"message":.,"sessions":$sessions}' | tr -d '\n'
            json_first=0
        else
            echo -e "  ${YELLOW}$(short_sha "$commit_sha")${RESET}  $commit_msg"
            while IFS= read -r session_id; do
                [ -n "$session_id" ] && echo -e "          ↳ ${CYAN}$(short_id "$session_id")${RESET}"
            done <<< "$note"
            echo ""
        fi
    done < <(git log --format="%H %s" -n "$count" 2>/dev/null)

    if [ $JSON_OUTPUT -eq 1 ]; then
        printf ']\n'
    elif [ $found -eq 0 ]; then
        echo "  No commits with linked sessions."
        echo ""
        echo "  Link a session: git atrace link <session_id> [commit]"
    fi
}

# Blame a file with session attribution
cmd_blame() {
    local target_file="$1"
    if [ -z "$target_file" ]; then
        echo "Usage: git atrace blame <file>"
        exit 1
    fi

    if [ ! -f "$target_file" ]; then
        echo "File not found: $target_file"
        exit 1
    fi

    # Create temp file for commit -> session cache
    local cache_file=$(mktemp)
    trap 'rm -f '"$cache_file" EXIT

    # Build cache: for each commit that touched this file, check for session note
    while IFS= read -r commit_sha; do
        [ -z "$commit_sha" ] && continue
        local session
        session=$(git notes --ref="$NOTES_REF" show "$commit_sha" 2>/dev/null | head -1) || session=""
        if [ -n "$session" ]; then
            echo "$commit_sha $session" >> "$cache_file"
        fi
    done < <(git log --format="%H" -- "$target_file" 2>/dev/null)

    echo -e "${BOLD}Blame: ${CYAN}$target_file${RESET}"
    echo -e "${DIM}(commits with linked sessions shown in cyan)${RESET}"
    echo ""

    # Run git blame and annotate with sessions
    git blame --porcelain "$target_file" 2>/dev/null | awk -v cache="$cache_file" -v cyan="$CYAN" -v dim="$DIM" -v yellow="$YELLOW" -v reset="$RESET" '
        BEGIN {
            while ((getline line < cache) > 0) {
                split(line, parts, " ")
                sessions[parts[1]] = parts[2]
            }
            close(cache)
        }
        /^[0-9a-f]{40}/ {
            commit = $1
            # Detect uncommitted changes (all zeros)
            if (commit ~ /^0+$/) {
                short_commit = "(local)"
                uncommitted = 1
            } else {
                short_commit = substr(commit, 1, 7)
                uncommitted = 0
            }
            session = ""
            if (commit in sessions) {
                session = substr(sessions[commit], 1, 8)
            }
            next
        }
        /^\t/ {
            content = substr($0, 2)
            if (uncommitted) {
                printf "%s%-7s%s %-8s %s\n", yellow, short_commit, reset, "", content
            } else if (session != "") {
                printf "%s%-7s%s %s%-8s%s %s\n", cyan, short_commit, reset, dim, session, reset, content
            } else {
                printf "%s%-7s%s %-8s %s\n", dim, short_commit, reset, "", content
            }
        }
    '
}

# Export session to Agent Trace spec format
# See https://agent-trace.dev for spec details
cmd_export() {
    local session_id="$1"
    if [ -z "$session_id" ]; then
        echo "Usage: git atrace export <session_id>" >&2
        exit 1
    fi

    # Check for jq
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq is required for export" >&2
        exit 1
    fi

    if ! find_session "$session_id" "jsonl"; then
        echo "Session not found: $session_id" >&2
        exit 1
    fi

    local root=$(git_root)
    local files_file="${SESSION_FILE%.jsonl}.files"
    local timestamp_file="${SESSION_FILE%.jsonl}.timestamp"

    # Get timestamp
    local timestamp=""
    if [ -f "$timestamp_file" ]; then
        timestamp=$(cat "$timestamp_file")
    else
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    fi

    # Get git revision (HEAD)
    local revision=""
    revision=$(git rev-parse HEAD 2>/dev/null) || revision=""

    # Try to extract model info from session
    local model_id=""
    model_id=$(jq -r 'select(.model != null) | .model' "$SESSION_FILE" 2>/dev/null | head -1) || model_id=""
    if [ -z "$model_id" ] || [ "$model_id" = "null" ]; then
        # Try to infer from version field (Claude Code sessions have this)
        local version=""
        version=$(jq -r 'select(.version != null) | .version' "$SESSION_FILE" 2>/dev/null | head -1) || version=""
        if [ -n "$version" ] && [ "$version" != "null" ]; then
            model_id="anthropic/claude"
        fi
    fi

    # Build files array
    local files_json="[]"
    if [ -f "$files_file" ]; then
        files_json=$(while IFS= read -r filepath; do
            [ -z "$filepath" ] && continue
            # Get relative path
            local rel_path="$filepath"
            if [ "${filepath#/}" != "$filepath" ]; then
                rel_path="${filepath#$root/}"
            fi

            # Get line count if file exists
            local end_line=1
            if [ -f "$root/$rel_path" ]; then
                end_line=$(wc -l < "$root/$rel_path" | tr -d ' ')
                [ "$end_line" -eq 0 ] && end_line=1
            fi

            # Build file object with conversation and ranges
            jq -n \
                --arg path "$rel_path" \
                --argjson start 1 \
                --argjson end "$end_line" \
                --arg model "$model_id" \
                '{
                    path: $path,
                    conversations: [{
                        ranges: [{
                            start_line: $start,
                            end_line: $end,
                            contributor: {
                                type: "ai",
                                model_id: (if $model != "" then $model else null end)
                            }
                        }]
                    }]
                }'
        done < "$files_file" | jq -s '.')
    fi

    # Build the Agent Trace record
    jq -n \
        --arg version "0.1" \
        --arg id "$SESSION_ID" \
        --arg timestamp "$timestamp" \
        --arg revision "$revision" \
        --argjson files "$files_json" \
        '{
            version: $version,
            id: $id,
            timestamp: $timestamp,
            files: $files,
            vcs: {
                type: "git",
                revision: $revision
            },
            tool: {
                name: "git-atrace",
                version: "0.1.0"
            }
        }'
}

# Import an Agent Trace spec file
cmd_import() {
    local input_file="$1"
    if [ -z "$input_file" ]; then
        echo "Usage: git atrace import <file>" >&2
        exit 1
    fi

    if [ ! -f "$input_file" ]; then
        echo "File not found: $input_file" >&2
        exit 1
    fi

    # Check for jq
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq is required for import" >&2
        exit 1
    fi

    # Validate and extract fields
    local session_id timestamp revision
    session_id=$(jq -r '.id // empty' "$input_file" 2>/dev/null) || session_id=""
    if [ -z "$session_id" ]; then
        echo "Error: Invalid Agent Trace file (missing 'id' or invalid JSON)" >&2
        exit 1
    fi

    timestamp=$(jq -r '.timestamp // empty' "$input_file" 2>/dev/null)
    if [ -z "$timestamp" ]; then
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    fi

    revision=$(jq -r '.vcs.revision // empty' "$input_file" 2>/dev/null)

    local local_dir=$(local_sessions)
    mkdir -p "$local_dir"

    # Extract file paths
    jq -r '.files[]?.path // empty' "$input_file" > "$local_dir/${session_id}.files" 2>/dev/null

    # Write timestamp
    echo "$timestamp" > "$local_dir/${session_id}.timestamp"

    # Create minimal JSONL (store the original trace as metadata)
    jq -c '{type: "import", timestamp: .timestamp, source: "agent-trace", trace: .}' "$input_file" \
        > "$local_dir/${session_id}.jsonl"

    echo -e "Imported session: ${CYAN}$(short_id "$session_id")${RESET}"

    # Link to commit if revision is provided and exists
    if [ -n "$revision" ]; then
        if git rev-parse "$revision" >/dev/null 2>&1; then
            cmd_link "$session_id" "$revision"
        else
            echo "  (commit $revision not found, skipping link)"
        fi
    fi
}

# Main
case "${1:-list}" in
    list|"")
        cmd_list
        ;;
    show)
        cmd_show "$2"
        ;;
    view)
        cmd_view "$2"
        ;;
    share)
        cmd_share "$2"
        ;;
    files)
        cmd_files "$2"
        ;;
    delete)
        cmd_delete "$2"
        ;;
    link)
        cmd_link "$2" "$3"
        ;;
    log)
        cmd_log "$2"
        ;;
    blame)
        cmd_blame "$2"
        ;;
    export)
        cmd_export "$2"
        ;;
    import)
        cmd_import "$2"
        ;;
    help)
        grep '^#/' <"$0" | cut -c4-
        ;;
    *)
        echo "Usage: git atrace [list|show|view|files|share|delete|link|log|blame|export|import|help]"
        echo "Run 'git atrace help' for more information."
        exit 1
        ;;
esac
